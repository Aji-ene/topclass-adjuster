{
  "name": "topclass-claims-processor",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered insurance claims processing platform for Topclass Adjusters",
  "main": "server/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/server.js",
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon server/server.js",
    "client:dev": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "build:client": "npm run build",
    "preview": "cd client && npm run preview",
    "lint": "eslint . --ext .js,.jsx",
    "format": "prettier --write .",
    "clean:uploads": "rm -rf server/uploads/*",
    "postinstall": "cd client && npm install"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@google/generative-ai": "^0.21.0",
    "cors": "^2.8.5",
    "docx": "^8.5.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fs-extra": "^11.2.0",
    "helmet": "^7.1.0",
    "mammoth": "^1.8.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.61.0",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "concurrently": "^8.2.2",
    "eslint": "^9.9.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "insurance",
    "claims",
    "adjuster",
    "ai",
    "llm",
    "claude",
    "gpt",
    "grok",
    "gemini"
  ],
  "author": "Hey Aji",
  "license": "UNLICENSED"
}